# EduMind AI environment variables (example - DO NOT commit real values)
# Copy to .env and fill in actual values for local development.

# Application
APP_NAME=EduMind AI
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (generate strong random values in production)
SECRET_KEY=change-me-64-char-random-secret-for-access-tokens
REFRESH_SECRET_KEY=change-me-64-char-random-secret-for-refresh-tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://edumind:edumind_password@localhost:5432/edumind
TEST_DATABASE_URL=postgresql+asyncpg://edumind:edumind_password@localhost:5432/edumind_test

# Redis (caching / background jobs)
REDIS_URL=redis://localhost:6379/0

# Security cookies
SESSION_COOKIE_NAME=edumind_session
COOKIE_SECURE=false          # set true behind HTTPS
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=edumind_csrf

# File upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_STORAGE_PATH=./uploads

# i18n
DEFAULT_LOCALE=uz
AVAILABLE_LOCALES=uz,ru,en

# Super admin bootstrap (development only - change in production)
SUPER_ADMIN_EMAIL=admin@edumind.uz
SUPER_ADMIN_PASSWORD=ChangeMeSuperAdmin123!

# ============ EduMind AI Core (Phase 2) ============
# Feature flags
AI_CORE_ENABLED=true
AI_RAG_ENABLED=true
AI_MCP_ENABLED=true
AI_CACHE_ENABLED=true
AI_TRACE_ENABLED=true

# Model provider (no secrets here; secret supplied via env var NAME only)
AI_DEFAULT_LLM_PROVIDER=
AI_DEFAULT_EMBEDDING_PROVIDER=
AI_LLM_PROVIDER_SECRET_ENV=          # e.g. EDUMIND_LLM_API_KEY (value set at runtime, never committed)
AI_EMBEDDING_PROVIDER_SECRET_ENV=    # e.g. EDUMIND_EMBEDDING_API_KEY
AI_ENABLED_PROVIDERS=                # comma-separated, e.g. "test,stub"

# RAG limits
AI_MAX_DOCUMENT_SIZE_MB=25
AI_DEFAULT_CHUNK_SIZE=1000
AI_DEFAULT_CHUNK_OVERLAP=200
AI_DEFAULT_TOP_K=10
AI_ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.txt,.md
AI_ALLOWED_DOCUMENT_MIMES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown

# Cache (Redis DB index 1, separate from Phase 1 db 0)
AI_CACHE_DEFAULT_TTL_SECONDS=300
AI_CACHE_REDIS_DB=1

# Security
AI_RATE_LIMIT_PER_MINUTE=60
AI_PROMPT_MAX_LENGTH=4000

# Trace
AI_TRACE_SAMPLE_RATE=1.0
AI_OTEL_ENDPOINT=                    # OpenTelemetry collector endpoint (optional, future)
